# Turso'dan olingan ma'lumotlar (turso.tech saytida ro'yxatdan o'tib, baza yaratganda beriladi)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Sessiya (login) uchun maxfiy kalit — istalgan uzun tasodifiy matn
JWT_SECRET=shu-yerga-uzun-tasodifiy-matn-yozing

# Server porti (Render o'zi avtomatik beradi, mahalliyda 4000 qoladi)
PORT=4000

# --- MTbank (coin sotib olish uchun alohida to'lov sayti) ---
# MTbank saytining manzili (oxirida / belgisiz)
# MTbank'dagi MERCHANT_SECRET bilan AYNAN BIR XIL bo'lishi kerak (kamida 32 belgi)
